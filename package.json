{
  "name": "@laboriouslabs/mimic",
  "version": "0.1.0",
  "description": "Local-first HTTP mock server and recording proxy for developers.",
  "license": "MIT",
  "author": "Laborious Labs (https://laboriouslabs.com)",
  "type": "module",
  "bin": {
    "mimic": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts --dir examples/mimic",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "htmx.org": "^2.0.11",
    "undici": "^8.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
